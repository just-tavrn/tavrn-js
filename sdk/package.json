{
  "name": "@tavrn/sdk",
  "version": "0.1.0",
  "description": "tavrn API client for web clients and bots, generated from the node's OpenAPI spec",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/just-tavrn/tavrn-js.git",
    "directory": "sdk"
  },
  "homepage": "https://github.com/just-tavrn/tavrn-js/tree/main/sdk#readme",
